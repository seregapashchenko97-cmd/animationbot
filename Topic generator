class TopicGenerator:
    def __init__(self):
        self.used_topics = []

    def generate_topic(self) -> dict:
        available = [t for t in TOPICS if t["title_en"] not in self.used_topics]
        if not available:
            self.used_topics = []
            available = TOPICS

        topic = random.choice(available)
        self.used_topics.append(topic["title_en"])

        theme = topic["theme"]
        scenes = SCENE_TEMPLATES.get(theme, SCENE_TEMPLATES["no_work"])

        random.shuffle(scenes)

        # Target ~10 min video: 30 scenes averaging 3 sec = 90 sec; we want ~150 scenes total for 10 min
        # Actually: 30 scenes * avg 3sec = 90sec. For 10 min we need ~150 scenes of avg 4 sec
        # Use all available scenes and repeat if needed
        target_scenes = 120
        extended_scenes = []
        while len(extended_scenes) < target_scenes:
            extended_scenes.extend(scenes)
        extended_scenes = extended_scenes[:target_scenes]

        # Vary durations: 1-5 seconds
        scenes_with_duration = []
        for prompt, base_dur in extended_scenes:
            dur = random.randint(max(1, base_dur - 1), min(5, base_dur + 1))
            scenes_with_duration.append({"prompt": prompt, "duration": dur})

        num_scenes = len(scenes_with_duration)
        scene_narrations = generate_scene_narrations(theme, num_scenes)

        voiceover_template = VOICEOVER_TEMPLATES.get(theme, DEFAULT_VOICEOVER)
        voiceover_text = voiceover_template.format(scene_narrations=scene_narrations)

        description_en = random.choice(DESCRIPTION_TEMPLATES["en"])

        tags = "#Money #Poverty #Psychology #Life #Finance #Truth #Wealth #Income #SelfImprovement #RealTalk"

        return {
            "title_en": topic["title_en"],
            "title_ru": topic["title_ru"],
            "theme": theme,
            "style_keywords": topic["style_keywords"],
            "scenes": scenes_with_duration,
            "voiceover": voiceover_text,
            "description_en": description_en,
            "description_ru": f"Это правдивая история. Без приукрашиваний. Досмотрите до конца — финал важен.",
            "tags": tags,
        }

    def get_sample_topics(self) -> list:
        return TOPICS
